DEFAULT_HOST="the ip address of the local SQL Server" # E.g. "sql.domain.suffix"
DEFAULT_ODBC_DRIVER="the preferred ODBC driver" # "SQL Server" will do in most cases
DEFAULT_DATA_CATALOG="the database holding the data table where I want to start working" # E.g. "dbo"
DEFAULT_DATA_TABLE="the table holding the data where I want to start working" # E.g. "schema.iris"
DEFAULT_CLASSIFICATION_CATALOG="the database where to store the classification results" # E.g. "dbo"
DEFAULT_CLASSIFICATION_TABLE="the table where to store the classification results" # E.g. "schema.Autoclassification"
DEFAULT_SMTP_SERVER="" # E.g. "smtp.domain.com", can be ignored
DEFAULT_NOTIFICATION_EMAIL="" # E.g. "name@domain.com", can be ignored
DEFAULT_N_JOBS_DESIRED="-1" # The number of processes / threads to use in parallel execution (-1 = all)
JBG_LOG_SENSITIVE_DATA="0" # 1 writes full SQL and row-level dataset samples to persistent logs; use only for trusted local diagnostics
JBG_GUI_PREFILL_SQL_CREDENTIALS="0" # 1 allows trusted local GUI prefill from JBG_SQL_USERNAME/JBG_SQL_PASSWORD; keep 0 in production
JBG_SQL_USERNAME="" # Optional local GUI/CLI SQL username; used for GUI only when JBG_GUI_PREFILL_SQL_CREDENTIALS=1
JBG_SQL_PASSWORD="" # Optional runtime-only SQL password; never generated or written back by JBG
JBG_METADATA_DB_HOST="" # 285d: SQL Server for durable run jobs; leave empty to use the local file output/run_jobs/jobs.sqlite
JBG_METADATA_DB_NAME="" # Database (catalog) holding the jbg_run_ tables
JBG_METADATA_DB_SCHEMA="" # Schema for the jbg_run_ tables; empty uses the login's default schema
JBG_METADATA_DB_USERNAME="" # SQL login for the metadata database; empty uses Windows authentication
JBG_METADATA_DB_PASSWORD="" # Never committed; read by the API server and its workers from .env
JBG_METADATA_DB_DRIVER="" # ODBC driver; empty uses DEFAULT_ODBC_DRIVER
